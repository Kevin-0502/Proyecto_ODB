# Copiar a .env y completar los valores. No subir el .env al repo.

# Servidor
PORT=3001
FRONTEND_URL=http://localhost:3000
API_KEY=

# Base de datos (SQL Server)
# Ojo en macOS/Linux: USER también es una variable del sistema y dotenv no la sobrescribe;
# si la conexión usa el usuario equivocado, revisar la variable USER de la terminal.
USER=
PASSWORD=
SERVER=
DATABASE=

# Tokens (en producción: valores largos y aleatorios)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Obligatorio y distinto de JWT_SECRET; si falta o es igual, el BE no arranca
JWT_SECRET_ORIENTADOR=

# Opcionales
# Días que dura cada jornada al calcular jornadas y suspensiones (por defecto 7)
# DIAS_POR_JORNADA=7
# Intentos fallidos permitidos en login_orientador cada 15 min (por defecto 5)
# LOGIN_ORIENTADOR_MAX_INTENTOS=5
# Si el BE va detrás de un proxy (nginx, Docker, etc.): número de proxies (solo números)
# TRUST_PROXY=1
