# Copiar a .env y completar los valores. No subir el .env al repo.

# Servidor
PORT=3001
FRONTEND_URL=http://localhost:3000
API_KEY=

# Base de datos (SQL Server)
USER=
PASSWORD=
SERVER=
DATABASE=

# Tokens (en producción: valores largos y aleatorios)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Obligatorio y distinto de JWT_SECRET; si falta o es igual, el BE no arranca
JWT_SECRET_ORIENTADOR=

# Opcionales
# Intentos fallidos permitidos en login_orientador cada 15 min (por defecto 5)
# LOGIN_ORIENTADOR_MAX_INTENTOS=5
# Activar si el BE va detrás de un proxy (nginx, Docker, etc.)
# TRUST_PROXY=1
